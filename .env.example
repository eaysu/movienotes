# --- Copy this file to ".env" and fill in your keys ---

# TMDb API key — get one free at https://www.themoviedb.org/settings/api
# Without it, the enrichment step is skipped (recommendations still work,
# but only on title text, which is weaker).
TMDB_API_KEY=

# OpenAI API key — https://platform.openai.com/api-keys
# Without it, the LLM ranking step falls back to plain similarity ordering.
OPENAI_API_KEY=

# Which model the LLM ranking layer uses.
OPENAI_MODEL=gpt-5-mini

# Separate model for the taste / personality analysis prose.
# Falls back to OPENAI_MODEL when empty.
OPENAI_ANALYSIS_MODEL=gpt-5.6-terra

# Supabase — https://supabase.com/dashboard/project/_/settings/api
# URL: Settings > API > Project URL
# KEY: Settings > API > service_role secret key (not the anon key)
# Without these, the app uses a local SQLite cache instead.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=

# Username-only auth kimliklerini ve doğrulama kodlarını HMAC ile türetir.
# Üretimde uzun/rastgele bir secret kullan; değişirse mevcut username login
# eşlemesi bozulur. Örnek üretim: openssl rand -hex 32
AUTH_IDENTITY_SECRET=
AUTH_COOKIE_SECURE=true
AUTH_SESSION_MAX_AGE=604800

# How many final recommendations to return.
NUM_RECOMMENDATIONS=5

# Taste ranking always uses the most recent N watched films. Favorite directors
# are a bounded secondary signal; 0.08 breaks close calls without dominating.
RECOMMENDATION_HISTORY_LIMIT=100
FAVORITE_DIRECTOR_BOOST=0.08

# Polite delay (seconds) between Letterboxd page requests.
SCRAPE_DELAY=1.0

# Where the local cache lives.
DATA_DIR=data

# --- Sinema gündemi ---
BULLETIN_ENABLED=true

# --- Günce taraması ---
# Saatlik tarama, üye başına tek istek. Maliyeti belirleyen üye sayısı, kayıt
# sayısı değil; bu yüzden bütçe üyede. Yazmayan üye geri çekiliyor (eşik
# MIN'den MAX'e ikiye katlanarak), ilk yeni kayıtta tabana dönüyor.
DIARY_SCAN_ENABLED=true
DIARY_SCAN_MEMBERS_PER_RUN=24
DIARY_SCAN_ENTRIES=3
DIARY_SCAN_MIN_HOURS=1
DIARY_SCAN_MAX_HOURS=12
# Yeni üyenin arşivi: uygulamaya girdikten sonra koş başına kaç sayfa.
DIARY_BACKFILL_MEMBERS_PER_RUN=2
DIARY_BACKFILL_PAGES_PER_RUN=3

# Her gün Türkiye saatiyle 22.00'de, izlenmemiş yerel katalogdan bir öneri.
NIGHTLY_PICK_ENABLED=true
NIGHTLY_PICK_HOUR=22
NIGHTLY_PICK_TIMEZONE=Europe/Istanbul
